{
  "manifestVersion": 2,
  "publisher": "personal",
  "name": "modeltrace-health",
  "displayName": "账号降智检测",
  "version": "1.4.6",
  "description": "ModelTrace 账户检测、自动复测、定时检查与指纹库在线更新",
  "license": "MIT",
  "engines": { "codex-proxy-rs": ">=3.29.1, <3.30.0" },
  "main": "bin/modeltrace-health",
  "runtime": "trustedProcess",
  "contributes": { "management": { "version": 2 }, "maintenance": {} },
  "configurationSchema": { "type": "object", "properties": {}, "additionalProperties": false },
  "resources": {
    "web/index.html": "text/html",
    "web/app.js": "text/javascript",
    "web/app.css": "text/css",
    "runtime/runtime.tar.gz": "application/gzip",
    "legal/NOTICE.md": "text/plain",
    "legal/THIRD_PARTY.txt": "text/plain"
  },
  "state": [
    { "namespace": "control", "schemaVersion": 1, "schema": { "type": "object" }, "maximumRecords": 16, "maximumBytes": 1048576, "maximumValueBytes": 262144, "migratesFrom": [] },
    { "namespace": "jobs", "schemaVersion": 1, "schema": { "type": "object" }, "maximumRecords": 2000, "maximumBytes": 16777216, "maximumValueBytes": 262144, "migratesFrom": [] },
    { "namespace": "banks", "schemaVersion": 1, "schema": { "type": "string" }, "maximumRecords": 160, "maximumBytes": 16777216, "maximumValueBytes": 262144, "migratesFrom": [] }
  ]
}
